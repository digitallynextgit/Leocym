# Copy to .env.local for local overrides.

# ---------------------------------------------------------------------------
# Search-engine indexing
# ---------------------------------------------------------------------------
#   unset / anything but "true"  -> robots.txt is `Disallow: /` and every page
#                                   carries noindex. This is the correct state
#                                   for every preview deployment, and for
#                                   production until the client signs off.
#   "true"                       -> the site becomes indexable.
#
# Leave this UNSET until Ms. Priya Lalani has approved the copy (see /review).
NEXT_PUBLIC_INDEXABLE=false

# ---------------------------------------------------------------------------
# Enquiry form -> SMTP  (src/app/api/enquiry/route.ts)
# ---------------------------------------------------------------------------
# The business enquiry form posts to /api/enquiry, which sends one email over
# SMTP. There is no database, no CRM and no queue: leads are handled by people
# (Marketing Strategy §14.9), so the form's only job is to put a well-formed
# message in the inbox that already receives them.
#
# With these unset the form still renders and still validates, but submitting
# returns a 503 and tells the reader to email instead. That is deliberate — a
# half-configured deploy should degrade to something honest, not fail silently.

# Your provider's outgoing mail server.
SMTP_HOST=smtp.example.com

# 587 (STARTTLS) or 465 (implicit TLS). Defaults to 587 if unset.
SMTP_PORT=587

# Optional. Defaults to true on port 465 and false otherwise, which is right for
# almost every provider. Set it only if yours does something unusual.
# SMTP_SECURE=false

# The authenticating mailbox.
SMTP_USER=
SMTP_PASS=

# The From address. MUST be a domain you are authorised to send as, or SPF and
# DMARC will reject the mail at the recipient. The enquirer's own address goes
# in Reply-To, never in From — sending as them is what lands the whole lead
# flow in spam.
ENQUIRY_FROM=website@leocym.com

# Where enquiries are delivered. Falls back to SITE.contact.email if unset.
ENQUIRY_TO=info@leocym.com
